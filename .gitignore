node_modules/
dist/
test-results/
*.tsbuildinfo
.DS_Store
# The demo's public/ is an ephemeral staging area for runtime assets; never
# committed. Its icons and manifest are the exception: committed static assets
# rather than staged runtime output. Git cannot re-include a path whose parent
# directory is excluded, so exclude the directory contents rather than the
# directory itself, then allow the two static entries back in. wasm-local.sh
# only clears public/runtime and the named legacy files, so staging the runtime
# leaves them alone.
apps/web-wallet-demo/public/*
!apps/web-wallet-demo/public/icons/
!apps/web-wallet-demo/public/manifest.json

# Superpowers SDD scratch (briefs, reports, ledger, review diffs).
.superpowers/

# Local plans and specs; kept out of the repo, discarded after implementation.
docs/superpowers/

# Per-checkout dev-server launch config: its port depends on what else is
# already listening locally, so it never transfers between worktrees. Only this
# one file is ignored; .claude/ is not ignored wholesale.
.claude/launch.json

# Staged gomobile bindings and native build output for the RN transport;
# staged by packages/react-native/scripts/fetch-bindings.sh (downloaded from
# the pinned wavelength release) or bindings-local.sh (built from a checkout).
packages/react-native/android/libs/
packages/react-native/ios/Wavewalletdk.xcframework/
packages/react-native/android/build/
# fetch-bindings.sh downloads into a temp directory beside the staged output so
# the final move is a rename rather than a copy of several hundred megabytes. A
# run killed before its cleanup trap fires leaves that directory behind.
packages/react-native/.fetch-bindings-*/
